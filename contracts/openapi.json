{
  "components": {
    "schemas": {
      "BatchRequest": {
        "description": "POST /events/batch 请求：1~1000 条事件。",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "BatchResponse": {
        "description": "POST /events/batch 响应（B.3）；errors 仅 rejected>0 时出现。",
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "deduplicated": {
            "default": false,
            "title": "Deduplicated",
            "type": "boolean"
          },
          "duplicated": {
            "title": "Duplicated",
            "type": "integer"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/EventBatchError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "rejected": {
            "title": "Rejected",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "duplicated",
          "rejected"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "错误体（附录 B.0）；运行时 extra 字段按需并入。",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "统一错误响应包裹：{\"error\": {code, message, request_id}}。",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "EventBatchError": {
        "description": "逐事件拒绝原因（不整批失败）：index 为批次内下标。",
        "properties": {
          "code": {
            "default": "VALIDATION_ERROR",
            "title": "Code",
            "type": "string"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "index",
          "message"
        ],
        "title": "EventBatchError",
        "type": "object"
      },
      "EventIn": {
        "description": "批量入库事件项（B.3）。\n\nevent_id：客户端可自带 UUID，但服务端**忽略之**——event_id 恒由服务端\nderive_event_id(tenant_ns, source_system|source_id|occurred_at|event_type)\n派生（幂等唯一事实来源，防客户端伪造不一致；见 service.ingest_batch：\nB.3 批次事件不携带源记录 source_id，派生时以 object_id 充当该槽位）。",
        "properties": {
          "actor_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "actor_type": {
            "anyOf": [
              {
                "enum": [
                  "HUMAN",
                  "SERVICE",
                  "AI"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Type"
          },
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "event_type": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$",
            "title": "Event Type",
            "type": "string"
          },
          "object_id": {
            "format": "uuid",
            "title": "Object Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "result_type": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Type"
          },
          "risk_level": {
            "anyOf": [
              {
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Level"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "source_system": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Source System",
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "object_id",
          "source_system",
          "occurred_at"
        ],
        "title": "EventIn",
        "type": "object"
      },
